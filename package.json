{
  "name": "ytbs-dgs-extension",
  "version": "6.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "node tools/lint.mjs",
    "test": "node --import tsx --test tests/unit/*.test.mjs",
